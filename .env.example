# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TPS_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE
# Usable pack size per car in kWh (prefilled by `tpshare setup` from the model)
TPS_PACK_KWH=Model Y=75,Model 3=57

# The home this app plans around
TPS_HOME_NAME=Home
TPS_HOME_ADDRESS=

# Discharge safety: the car NEVER goes below this battery percentage
TPS_RESERVE_SOC=20
# Max power to the house in kW (typical home backup panel: 7.6)
TPS_MAX_DISCHARGE_KW=7.6

# The OpenAI-compatible server THIS app exposes
TPS_SERVER_HOST=127.0.0.1
TPS_SERVER_PORT=8651
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TPS_SERVER_API_KEY=
TPS_MODEL_ID=tesla-power-share

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# The app works FULLY without a backend (rules engine); the LLM only handles
# free-form questions. Vehicle data is sent only to this backend — nowhere else.
TPS_AI_BASE_URL=http://localhost:11434/v1
TPS_AI_API_KEY=
TPS_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TPS_AI_MODE=auto
TPS_AI_TIMEOUT_SECONDS=20

TPS_EMBEDDING_DIM=384
TPS_TOKEN_FILE=~/.tps/tokens.json
# 1 = preview discharge commands instead of sending them (default: preview,
# because Tesla doesn't expose discharge controls yet — see API_PROPOSAL.md)
TPS_DRY_RUN=1
